# Environment Variables
GEMINI_API_KEY=
# Supabase project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=
VITE_SUPABASE_URL=

# Server-only key: use the Supabase service_role/secret key. Never add VITE_ to this variable.
# SUPABASE_KEY is retained as a legacy fallback for existing Hostinger deployments.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=

# Browser-safe Supabase publishable key (or legacy anon key only).
VITE_SUPABASE_ANON_KEY=
