# Environment Variables
# Server-only Google AI key. Never expose this as a VITE_* variable.
GEMINI_API_KEY=

# Stable secret used to sign HttpOnly session cookies.
# Generate a unique random value for each environment (for example: openssl rand -hex 32).
SESSION_SECRET=

# Optional Supabase Integration (leave empty to use built-in local SQLite database)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Active Supabase Storage buckets: media, admin-media, blog, attractions, avatars, cities, attraction-photos
# These browser variables must contain only the public anon/publishable key, never a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=media

# Server-only administrator passcode. Set a strong, unique value in production.
ADMIN_PASSWORD=
