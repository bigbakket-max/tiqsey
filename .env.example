# ==============================================================================
# Server-Only Secrets (NEVER prefix with VITE_ — kept strictly on the backend)
# ==============================================================================
GEMINI_API_KEY=
# Supabase Integration (existing Tiqsey project)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
# Active Supabase Storage buckets: media, admin-media, blog, attractions, avatars, cities, attraction-photos
# Server-side admin passcode for signed HttpOnly admin session cookies
ADMIN_PASSWORD=

# ==============================================================================
# Subdomain Deployment & CORS Configuration
# ==============================================================================
# Set APP_MODE=admin on https://admin.tiqsey.com (or 'public' on storefront-only servers, 'dual' for local preview)
APP_MODE=dual
# Comma-separated list of allowed browser origins for authenticated API/CORS requests
CORS_ALLOWED_ORIGINS=https://admin.tiqsey.com,https://tiqsey.com,https://www.tiqsey.com

# ==============================================================================
# Public Browser-Safe Frontend Variables (VITE_*)
# ==============================================================================
# Set VITE_APP_MODE=admin for admin.tiqsey.com build, VITE_APP_MODE=public for tiqsey.com build
VITE_APP_MODE=dual
VITE_PUBLIC_SITE_URL=https://tiqsey.com
VITE_ADMIN_SITE_URL=https://admin.tiqsey.com
# Optional: leave empty when frontend and /api/* run on the same host (recommended for admin.tiqsey.com)
VITE_API_BASE_URL=
# Public Supabase URL and publishable/anon key ONLY (never service-role key!)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=media
